{
  "name": "ge-parcel-compare",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension comparing Georgian forwarder landed costs (Camex, Inex, USA2Georgia) on retailer product pages",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "zip": "npm run build && cd dist && zip -r ../ge-parcel-compare.zip . -x '.*'"
  },
  "dependencies": {
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@preact/preset-vite": "^2.9.0",
    "@types/chrome": "^0.0.280",
    "@types/node": "^26.4.1",
    "jsdom": "^25.0.0",
    "puppeteer-core": "^25.10.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
